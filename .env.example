# Authorized RESO Web API credentials supplied by the MLS/IDX vendor.
MLS_API_URL=https://api.your-idx-provider.com/odata
MLS_API_TOKEN=
MLS_AGENT_ID=

# Optional public listing-page prefix, if the vendor supplies one.
MLS_PUBLIC_LISTING_URL=

